server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # Long-cache hashed build assets.
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # Single-page-app fallback (the app has a single route today).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
